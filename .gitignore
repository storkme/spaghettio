venv/
refs/
!/docs/refs/
__pycache__/
*.pyc
*.egg-info/
.eggs/
dist/
build/
*.blueprint
blueprint_viz.html
test_viz/

# Local cargo toolchain config (hermetic cc wrapper on boxes without system cc)
.cargo/

# Claude Code worktrees
.claude/worktrees/
misc/
scripts/blueprints/
scripts/*.log
/graphics/
target/

# Factorio-SAT checkout (offline balancer-template regeneration only).
# Keep the README so setup instructions are tracked.
external/*
!external/README.md

# Bench artifacts (overnight synth/place runs)
bench-logs/

# Playwright CLI / MCP artifacts
.playwright-cli/
web/.playwright-cli/
.playwright-mcp/
web/.playwright-mcp/

# Environment-local secrets
.env

# Ephemeral per-session scheduler lock (session id + pid). Accidentally
# tracked once; every concurrent Claude session rewrites it, so tracking it
# guarantees permanent working-tree churn.
.claude/scheduled_tasks.lock

# Web app
web/node_modules/
web/dist/
web/src/wasm-pkg/


# Local-only debug scripts. Note the trailing `/*` rather than `/`: a negation
# cannot re-include a file whose PARENT DIRECTORY is excluded, because git never
# descends into it. Excluding the contents instead leaves the directory visible
# so the exception below can apply.
/crates/core/examples/*
# ...except the sim generator. `docs/sim-harness.md` recorded "on a fresh clone
# there is no tracked way to produce the pair" as a known gap; this closes it
# while keeping every other script in the directory local-only.
!/crates/core/examples/sim_export.rs
# ...and the four probes that generate RFC-066's headline corpus numbers. Same
# reasoning as sim_export above: a reader who cannot regenerate a figure cannot
# detect corpus drift, and an RFC resting on unreproducible aggregates has the
# same defect as one citing an uncommitted file.
!/crates/core/examples/probe_walkers.rs
!/crates/core/examples/probe_overcap_triage.rs
!/crates/core/examples/probe_b8_modes.rs
!/crates/core/examples/probe_walker_shape.rs
# ...and the Phase-0 probes for the cell-interface DB investigation
# (RFC-067): they produce the quoted census/cost numbers, same reasoning
# again, along with the corpus file they share.
!/crates/core/examples/probe_motif_census.rs
!/crates/core/examples/probe_motif_cost.rs
!/crates/core/examples/celldb
!/crates/core/examples/celldb/corpus.rs
# ...and the RFC-067 celldb tools: the seed tool regenerates the embedded
# store (a tracked artifact must have a tracked producer), and the
# calibration probe is K67-2's instrument — its verdict gates the preview.
!/crates/core/examples/celldb_seed.rs
!/crates/core/examples/celldb_preview_calibration.rs
# ...and the hotspot probe (RFC-067 follow-up): produces the area-budget /
# whitespace-decomposition numbers; same tracked-producer reasoning.
!/crates/core/examples/probe_hotspots.rs

# not sure what this is even lol
*:Zone.Identifier
